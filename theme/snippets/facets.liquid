{% doc %}
Renders native Shopify filters and sort with a GET fallback.
@param {collection} results - Collection or search results
@param {string} form_id - Unique form id
{% enddoc %}
<form method="get" class="facets" id="{{ form_id }}">
{% if results.terms %}<input type="hidden" name="q" value="{{ results.terms | escape }}"><input type="hidden" name="options[prefix]" value="last">{% endif %}
<label for="{{ form_id }}-sort">{{ 'collection.sort' | t }}</label>
{% assign selected_sort = results.sort_by | default: results.default_sort_by %}
<select id="{{ form_id }}-sort" name="sort_by">{% for option in results.sort_options %}<option value="{{ option.value | escape }}"{% if option.value == selected_sort %} selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select>
{% for filter in results.filters %}
<details open><summary>{{ filter.label | escape }}{% if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}</summary>
{% case filter.type %}
{% when 'boolean', 'list' %}
{% for value in filter.values %}<label class="filter-option"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% elsif value.count == 0 %} disabled{% endif %}> <span>{{ value.label | escape }}</span><span class="muted">{{ value.count }}</span></label>{% endfor %}
{% when 'price_range' %}
<div class="price-range"><label>{{ 'collection.min' | t }}<input type="number" name="{{ filter.min_value.param_name }}" min="0" step="0.01" placeholder="0"{% if filter.min_value.value %} value="{{ filter.min_value.value | divided_by: 100.0 }}"{% endif %}></label><label>{{ 'collection.max' | t }}<input type="number" name="{{ filter.max_value.param_name }}" min="0" step="0.01" placeholder="{{ filter.range_max | divided_by: 100.0 }}"{% if filter.max_value.value %} value="{{ filter.max_value.value | divided_by: 100.0 }}"{% endif %}></label></div>
{% endcase %}
</details>
{% endfor %}
<button type="submit" class="button">{{ 'general.apply' | t }}</button>
<a class="text-link" href="{% if results.terms %}{{ routes.search_url }}?q={{ results.terms | url_encode }}{% else %}{{ results.url }}{% endif %}">{{ 'collection.clear' | t }}</a>
</form>
