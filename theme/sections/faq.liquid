<section class="container section faq-section"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.contact != blank %}<a class="text-link" href="{{ section.settings.contact }}">{{ 'contact.more_help' | t }} ↗</a>{% endif %}</div><div>{% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}</summary><div class="rte">{{ block.settings.answer }}</div></details>{% endfor %}</div></section>
{% schema %}
{"name":"Preguntas frecuentes","settings":[{"type":"text","id":"eyebrow","label":"Antetítulo","default":"ANTES DE ELEGIR"},{"type":"text","id":"heading","label":"Título","default":"RESOLVEMOS TUS DUDAS."},{"type":"url","id":"contact","label":"Contacto"}],"blocks":[{"type":"question","name":"Pregunta","settings":[{"type":"text","id":"question","label":"Pregunta","default":"¿Cómo elijo mi bicicleta?"},{"type":"richtext","id":"answer","label":"Respuesta","default":"<p>Empieza por el terreno y el uso que le darás. Revisa la ficha de cada modelo y su guía de tallas antes de comprar.</p>"}]}],"presets":[{"name":"Preguntas frecuentes","blocks":[{"type":"question"}]}]}
{% endschema %}

