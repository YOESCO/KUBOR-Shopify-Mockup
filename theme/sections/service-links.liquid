<section class="section container"><div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div></div><div class="service-grid">{% for block in section.blocks %}<article class="service-card" {{ block.shopify_attributes }}><span class="eyebrow">0{{ forloop.index }} / {{ block.settings.label | escape }}</span><h3>{{ block.settings.title | escape }}</h3><p class="muted">{{ block.settings.text | escape }}</p>{% if block.settings.link != blank %}<a class="text-link" href="{{ block.settings.link }}">{{ block.settings.button | escape }} ↗</a>{% endif %}</article>{% endfor %}</div></section>
{% schema %}
{"name":"Ayuda para elegir","settings":[{"type":"text","id":"eyebrow","label":"Antetítulo","default":"CONTIGO EN CADA PASO"},{"type":"text","id":"heading","label":"Título","default":"ELIGE CON CONFIANZA."}],"max_blocks":4,"blocks":[{"type":"service","name":"Enlace de ayuda","settings":[{"type":"text","id":"label","label":"Categoría","default":"ANTES DE RODAR"},{"type":"text","id":"title","label":"Título","default":"Encuentra tu talla"},{"type":"textarea","id":"text","label":"Descripción","default":"Consulta la guía del modelo y resuelve tus dudas antes de elegir."},{"type":"text","id":"button","label":"Botón","default":"Ver guía"},{"type":"url","id":"link","label":"Destino"}]}],"presets":[{"name":"Ayuda para elegir"}]}
{% endschema %}

