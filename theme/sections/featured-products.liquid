<section class="section section--soft"><div class="container">
<div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><a class="text-link" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{{ 'general.see_all' | t }} ↗</a></div>
<div class="product-grid product-grid--rail">
{% for product in section.settings.collection.products limit: section.settings.limit %}{% render 'card-product', product: product %}{% else %}{% if request.design_mode %}<p>{{ 'general.select_collection' | t }}</p>{% else %}<a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.explore' | t }}</a>{% endif %}{% endfor %}
</div></div></section>
{% schema %}
{"name":"Selección de productos","settings":[{"type":"text","id":"eyebrow","label":"Antetítulo","default":"ENCUENTRA TU PRÓXIMA BICI"},{"type":"text","id":"heading","label":"Título","default":"LISTAS PARA RODAR."},{"type":"collection","id":"collection","label":"Colección"},{"type":"range","id":"limit","label":"Productos","min":2,"max":8,"step":1,"default":4}],"presets":[{"name":"Selección de productos"}]}
{% endschema %}
