<section class="container section bike-finder">
<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}</h1><p class="muted">{{ section.settings.text | escape }}</p>
<div class="service-grid">
{% for block in section.blocks %}<article class="service-card" {{ block.shopify_attributes }}><p class="eyebrow">0{{ forloop.index }} / {{ block.settings.terrain | escape }}</p><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.description | escape }}</p><details><summary>{{ block.settings.detail_label | escape }}</summary><div class="rte">{{ block.settings.detail }}</div></details>{% if block.settings.collection != blank %}<a class="text-link" href="{{ block.settings.collection.url }}">{{ block.settings.button | escape }} ↗</a>{% endif %}</article>{% endfor %}
</div></section>
{% schema %}
{"name":"Encuentra tu bicicleta","settings":[{"type":"text","id":"eyebrow","label":"Antetítulo","default":"ELIGE POR CÓMO QUIERES RODAR"},{"type":"text","id":"heading","label":"Título","default":"EMPIEZA POR TU TERRENO."},{"type":"textarea","id":"text","label":"Introducción","default":"El mejor punto de partida es el uso que le darás a tu bicicleta. Después, compara la talla y el equipamiento de cada modelo."}],"blocks":[{"type":"terrain","name":"Tipo de uso","settings":[{"type":"text","id":"terrain","label":"Terreno","default":"FUERA DEL ASFALTO"},{"type":"text","id":"title","label":"Título","default":"Montaña"},{"type":"textarea","id":"description","label":"Descripción","default":"Para caminos de tierra, senderos y recorridos con desnivel."},{"type":"text","id":"detail_label","label":"Título del acordeón","default":"Qué debes revisar"},{"type":"richtext","id":"detail","label":"Consejos","default":"<p>Compara tipo de suspensión, frenos, geometría y el uso recomendado por el fabricante. Una bicicleta recreativa no sustituye una diseñada para saltos o descenso.</p>"},{"type":"collection","id":"collection","label":"Colección recomendada"},{"type":"text","id":"button","label":"Botón","default":"Ver modelos"}]}],"presets":[{"name":"Encuentra tu bicicleta"}]}
{% endschema %}
