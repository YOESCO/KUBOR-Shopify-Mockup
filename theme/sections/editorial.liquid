<section{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %} class="editorial{% if section.settings.gradient %} editorial--gradient{% endif %}">
<div class="editorial__media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600,900,1400', sizes: '(min-width: 900px) 50vw, 100vw' }}{% elsif section.settings.use_editorial_image %}<img src="{{ 'ride-editorial.jpg' | asset_url }}" width="1920" height="1280" loading="lazy" alt="">{% else %}<div class="gradient-orbit" aria-hidden="true"><span>HYPER<br>GOGO</span></div>{% endif %}</div>
<div class="editorial__copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2{% if section.settings.gradient %} class="gradient-text"{% endif %}>{{ section.settings.heading | escape | newline_to_br }}</h2><div class="rte">{{ section.settings.text }}</div>{% if section.settings.button_label != blank and section.settings.button_link != blank %}<a class="button{% unless section.settings.gradient %} button--outline{% endunless %}" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }} {% render 'icon', name: 'arrow' %}</a>{% endif %}</div>
</section>
{% schema %}
{"name":"Historia de marca","settings":[{"type":"text","id":"anchor","label":"Ancla de enlace (opcional)"},{"type":"text","id":"eyebrow","label":"Antetítulo","default":"KUBOR / MÁS ALLÁ"},{"type":"textarea","id":"heading","label":"Título","default":"LA AVENTURA\nNO SE QUEDA QUIETA."},{"type":"richtext","id":"text","label":"Contenido","default":"<p>Caminos nuevos, vueltas conocidas y todo lo que pasa entre ellos. Haz espacio para salir a rodar.</p>"},{"type":"image_picker","id":"image","label":"Fotografía"},{"type":"checkbox","id":"use_editorial_image","label":"Usar fotografía editorial incluida","default":true},{"type":"checkbox","id":"gradient","label":"Degradado HYPERGOGO","default":false},{"type":"text","id":"button_label","label":"Botón","default":"Descubre KUBOR"},{"type":"url","id":"button_link","label":"Destino"}],"presets":[{"name":"Historia de marca"},{"name":"HYPERGOGO · Degradado","settings":{"gradient":true,"use_editorial_image":false,"eyebrow":"HYPERGOGO / ELECTRIC FUN","heading":"OTRA FORMA\nDE SENTIRLO.","text":"<p>Color, energía y nuevas maneras de explorar. Descubre la familia HYPERGOGO y encuentra el modelo adecuado para cada aventura.</p>","button_label":"Explorar HYPERGOGO"}}]}
{% endschema %}
