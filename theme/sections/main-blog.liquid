<section class="container section"><p class="eyebrow">{{ 'blog.eyebrow' | t }}</p><h1>{{ blog.title | escape }}</h1><nav class="blog-tags" aria-label="{{ 'blog.categories' | t }}"><a href="{{ blog.url }}">{{ 'general.see_all' | t }}</a>{% for tag in blog.all_tags %}{{ tag | link_to_tag: tag }}{% endfor %}</nav>{% paginate blog.articles by 9 %}<div class="article-grid">{% for article in blog.articles %}<article>{% if article.image %}<a href="{{ article.url }}">{{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,700,1000', sizes: '(min-width: 900px) 33vw, 100vw' }}</a>{% endif %}<p class="eyebrow">{{ article.published_at | date: '%d/%m/%Y' }}</p><h2><a href="{{ article.url }}">{{ article.title | escape }}</a></h2><p>{{ article.excerpt_or_content | strip_html | truncate: 170 }}</p><a class="text-link" href="{{ article.url }}">{{ 'general.read' | t }} ↗</a></article>{% else %}<p>{{ 'blog.empty' | t }}</p>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="pagination" aria-label="{{ 'general.pagination' | t }}">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}</section>
{% schema %}{"name":"Journal","settings":[]}{% endschema %}

