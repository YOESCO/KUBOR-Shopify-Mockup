<section class="container section"><p class="eyebrow">{{ 'general.explore' | t }}</p><h1>{{ 'general.collections' | t }}</h1>{% paginate collections by 24 %}<div class="category-grid collection-cards">{% for collection in collections %}<a class="collection-card" href="{{ collection.url }}">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(min-width: 900px) 33vw, 90vw' }}{% else %}<div class="collection-placeholder" aria-hidden="true">{{ 'collection-1' | placeholder_svg_tag }}</div>{% endif %}<h2>{{ collection.title | escape }} <span aria-hidden="true">↗</span></h2></a>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="pagination" aria-label="{{ 'general.pagination' | t }}">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}</section>
{% schema %}{"name":"Colecciones","settings":[]}{% endschema %}
