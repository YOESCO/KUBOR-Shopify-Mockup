<section class="container section prose"><img src="{{ 'kubor-logo-light.svg' | asset_url }}" width="160" height="42" alt="{{ shop.name | escape }}"><p class="eyebrow">{{ 'password.eyebrow' | t }}</p><h1>{{ section.settings.heading | escape }}</h1><div class="rte">{{ shop.password_message }}</div>{% form 'storefront_password' %}{{ form.errors | default_errors }}<label for="Password">{{ 'password.label' | t }}</label><input id="Password" name="password" type="password" autocomplete="current-password" required><button type="submit" class="button">{{ 'password.enter' | t }}</button>{% endform %}</section>
{% schema %}{"name":"Próxima apertura","settings":[{"type":"text","id":"heading","label":"Título","default":"UNA NUEVA RUTA ESTÁ POR EMPEZAR."}]}{% endschema %}
