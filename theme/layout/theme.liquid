<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#071820">
<link rel="canonical" href="{{ canonical_url }}">
<title>{{ page_title | escape }}{% unless page_title contains shop.name %} — {{ shop.name | escape }}{% endunless %}</title>
{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:title" content="{{ page_title | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
{% if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}
{% if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{% endif %}
{% if settings.favicon != blank %}<link rel="icon" href="{{ settings.favicon | image_url: width: 32 }}">{% endif %}
{{ 'kubor.css' | asset_url | stylesheet_tag }}
<script src="{{ 'kubor.js' | asset_url }}" defer></script>
{{ content_for_header }}
</head>
<body>
<a class="skip-link" href="#MainContent">{{ 'general.skip' | t }}</a>
{% sections 'header-group' %}
<main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
{% sections 'footer-group' %}
{% section 'cart-drawer' %}
<div id="SiteStatus" class="sr-only" role="status" aria-live="polite"></div>
<script id="KuborConfig" type="application/json">
{"root":{{ routes.root_url | json }},"cart":{{ routes.cart_url | json }},"cartAdd":{{ routes.cart_add_url | json }},"cartChange":{{ routes.cart_change_url | json }},"searchSuggest":{{ routes.predictive_search_url | json }},"error":{{ 'general.error' | t | json }},"added":{{ 'cart.added' | t | json }},"updated":{{ 'cart.updated' | t | json }},"loading":{{ 'general.loading' | t | json }}}
</script>
</body>
</html>
