{% layout none %}
<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>{{ 'gift.title' | t }} — {{ shop.name | escape }}</title>{{ 'kubor.css' | asset_url | stylesheet_tag }}{{ content_for_header }}</head><body><main class="container section prose"><p class="eyebrow">{{ shop.name | escape }}</p><h1>{{ 'gift.title' | t }}</h1><p class="gift-balance">{{ gift_card.balance | money_with_currency }}</p>{% if gift_card.enabled and gift_card.expired == false %}<p>{{ 'gift.code' | t }}</p><p class="gift-code">{{ gift_card.code | format_code }}</p>{% else %}<p>{{ 'gift.unavailable' | t }}</p>{% endif %}{% if gift_card.expires_on %}<p>{{ 'gift.expires' | t }} {{ gift_card.expires_on | date: '%d/%m/%Y' }}</p>{% endif %}<a class="button" href="{{ shop.url }}">{{ 'general.explore' | t }}</a>{% if gift_card.pass_url %}<a class="text-link" href="{{ gift_card.pass_url }}">{{ 'gift.wallet' | t }}</a>{% endif %}</main></body></html>

